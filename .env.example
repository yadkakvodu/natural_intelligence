# copy to .env and fill in
# LLM gateway (needed for insight/chat; feed works without it)
DEEPSEEK_API_KEY=
GATEWAY_BASE_URL=https://changellenge.up.railway.app/v1
MODEL_NAME=deepseek/deepseek-v4.1-flash

# host ports
BACKEND_PORT=8080
AI_CORE_PORT=8000
DB_HOST_PORT=55432

# database credentials (used by db, backend and ai-core)
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=natural_intelligence
